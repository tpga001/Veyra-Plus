{
  "manifest_version": 3,
  "name": "Veyra 浏览器视频增强",
  "description": "自动识别当前前台网页的主视频，由 Veyra 在视频区域内增强。",
  "version": "0.2.3",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Veyra 视频增强",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "video-geometry.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "key": ""
}
